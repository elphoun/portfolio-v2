# Spotify integration for the spinning disc (app/components/spotify-disc.tsx)
# Copy this file to `.env.local` and fill in the values.
#
# 1. Create an app at https://developer.spotify.com/dashboard
#    - Add this Redirect URI (exact match): http://127.0.0.1:3000/api/spotify/callback
# 2. Put the Client ID / Secret below, run `npm run dev`, then visit
#    http://127.0.0.1:3000/api/spotify/login and authorize.
# 3. Copy the printed SPOTIFY_REFRESH_TOKEN back into this file (and into your
#    Vercel project env vars for production).

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: override the OAuth redirect URI (defaults to the request origin +
# /api/spotify/callback). Must exactly match a Redirect URI registered on the
# Spotify app. For production set this to https://<your-domain>/api/spotify/callback
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
